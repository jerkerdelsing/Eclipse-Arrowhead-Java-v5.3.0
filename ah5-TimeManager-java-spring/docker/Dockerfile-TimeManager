# Build context: the workspace root that contains ah5-common-java-spring, ah5-core-java-spring and ah5-support-java-spring.
# Stage 1: build
FROM eclipse-temurin:21-jdk@sha256:ebfbb18d11ff163ee83b21258acf12248af48d22a0fdfdc68fa1a1516c05976a AS build

ARG AH_VERSION=5.3.0

RUN apt-get update && apt-get install -y maven dos2unix

WORKDIR /common
COPY ah5-common-java-spring .
RUN mvn clean install -DskipTests

# Parent pom (arrowhead-core) of the support module
WORKDIR /core
COPY ah5-core-java-spring/pom.xml pom.xml
RUN mvn -N install

WORKDIR /app
COPY ah5-support-java-spring/TimeManager .
RUN dos2unix /app/docker/entrypoint.sh
RUN mvn -DskipTests clean package

# Stage 2: runtime
FROM eclipse-temurin:21-jre@sha256:0b99b3376fbb50dbf9c0af8535fdd5b8eb0d3fdfc8b1e4967f383b6919f6901a
# SOS-16 (2026-11-10): Ubuntu security updates on top of the pinned base image
RUN apt-get update && apt-get -y upgrade && rm -rf /var/lib/apt/lists/*

ARG AH_VERSION=5.3.0
ENV AH_VERSION=$AH_VERSION

WORKDIR /app
COPY --from=build /app/target/arrowhead-timemanager-${AH_VERSION}.jar arrowhead-timemanager-${AH_VERSION}.jar
COPY --from=build /app/target/application.properties config_temp/application.properties
COPY --from=build /app/target/log4j2.xml config_temp/log4j2.xml
COPY --from=build /app/docker/entrypoint.sh entrypoint.sh

RUN chmod +x entrypoint.sh
EXPOSE 8463
ENTRYPOINT ["/app/entrypoint.sh"]
