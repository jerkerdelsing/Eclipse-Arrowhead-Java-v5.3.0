<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests: console logging only. The JDBC appender of log4j2.xml waits for the Spring context and would block unit tests that
     log before any context exists. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="ConsoleAppender" target="SYSTEM_OUT" follow="true">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %5p [%15.15t] %-40.40c{1.} : %m%n%ex"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="WARN">
            <AppenderRef ref="ConsoleAppender"/>
        </Root>
    </Loggers>
</Configuration>
