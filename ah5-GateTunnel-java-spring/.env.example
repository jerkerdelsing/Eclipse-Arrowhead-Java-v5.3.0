# Copy to .env and adapt to an existing local cloud. No credentials are supplied.
COMPOSE_PROJECT_NAME=ah5-gatetunnel-testcloud
LOCAL_CLOUD=TestCloud
ORGANIZATION=Company
ARROWHEAD_NETWORK=arrowhead-local-cloud
SERVICE_REGISTRY_ADDRESS=serviceregistry
SERVICE_REGISTRY_PORT=8443
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=8453
# Private database network of this system (internal); pick a free subnet
DB_SUBNET=10.252.213.0/24
# Secrets (one value per file)
IDENTITY_PASSWORD_FILE=./security/identity-password
STORE_PASSWORD_FILE=./security/store-password
DB_PASSWORD_FILE=./security/db-password
DB_ROOT_PASSWORD_FILE=./security/db-root-password
# System identity (PKCS12, alias GateTunnel.<LOCAL_CLOUD>.<ORGANIZATION>.arrowhead.eu) and trust store
SYSTEM_KEYSTORE_FILE=./security/GateTunnel.p12
TRUSTSTORE_FILE=./security/truststore.p12
CRL_DIRECTORY=./security/crl
# Database TLS (server certificate for gatetunnel-db, and the CA the system verifies it with)
DB_CA_FILE=./security/db-ca.crt
DB_CERT_FILE=./security/db.crt
DB_KEY_FILE=./security/db.key
# sysMonitor (AMQP over mutual TLS)
AMQP_HOST=amqp-broker
AMQP_PORT=5671
SYSMONITOR_ENABLED=true
# Federation: ah-gt-1 (end-to-end protected) or legacy-mtls; no fallback between them
FEDERATION_PROFILE=ah-gt-1
NEIGHBOR_CLOUDS=
FEDERATION_PEER_ORGANIZATIONS=
ADVERTISED_ADDRESS=gatetunnel
# Relay identity (PEM): relay certificate + cross-certificate, its key, the organisation CA
RELAY_HOST=arrowhead-relay
RELAY_PORT=8883
RELAY_CHAIN_FILE=./security/gatetunnel-relay-chain.crt
RELAY_KEY_FILE=./security/gatetunnel-relay.key
ORGANIZATION_CA_FILE=./security/org-ca.crt
# Port pools: control sessions (bookkeeping) and inter-cloud consumer tunnel listeners
MIN_TUNNEL_PORT=8000
MAX_TUNNEL_PORT=8099
INTERCLOUD_MIN_PORT=8200
INTERCLOUD_MAX_PORT=8299
SESSION_MAX_AGE_SECONDS=43200
SESSION_IDLE_SECONDS=3600
