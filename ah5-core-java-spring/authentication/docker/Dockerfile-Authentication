# Stage 1: Build (jdk needed)
FROM eclipse-temurin:21-jdk@sha256:ebfbb18d11ff163ee83b21258acf12248af48d22a0fdfdc68fa1a1516c05976a AS build

ARG AH_VERSION

RUN apt-get update && \
    apt-get install -y maven && \
	apt-get install -y dos2unix
	
WORKDIR /common
COPY ah5-common-java-spring .
RUN mvn clean install -DskipTests

WORKDIR /app
COPY ah5-core-java-spring .
RUN dos2unix /app/authentication/docker/entrypoint.sh
RUN mvn -pl authentication -am -DskipTests clean install

# Stage 2: Runtime (jdk not needed)
FROM eclipse-temurin:21-jre@sha256:0b99b3376fbb50dbf9c0af8535fdd5b8eb0d3fdfc8b1e4967f383b6919f6901a
# SOS-16 (2026-11-10): Ubuntu security updates on top of the pinned base image
RUN apt-get update && apt-get -y upgrade && rm -rf /var/lib/apt/lists/*

ARG AH_VERSION
ENV AH_VERSION=$AH_VERSION

WORKDIR /app
COPY --from=build /app/authentication/target/arrowhead-authentication-${AH_VERSION}.jar arrowhead-authentication-${AH_VERSION}.jar
COPY --from=build /app/authentication/target/application.properties config_temp/application.properties
COPY --from=build /app/authentication/target/log4j2.xml config_temp/log4j2.xml
COPY --from=build /app/authentication/src/main/resources/certificate config_temp/certificte
COPY --from=build /app/authentication/docker/entrypoint.sh entrypoint.sh

# Release 5.3.0: run as an unprivileged user (UID/GID 10001, as the support images). The entrypoint moves the default
# configuration from config_temp to /app/config and the logs are written to /app, so /app belongs to that user; a
# volume or bind mount at /app/config must be writable by UID 10001.
RUN chmod +x entrypoint.sh && mkdir -p /app/config && chown -R 10001:10001 /app
USER 10001:10001

ENTRYPOINT ["/app/entrypoint.sh"]