  "networkProperties": [
    {
      "id": "IP1",
      "label": "Location-independent endpoint identity: services are addressed by logical endpoint identifiers (LEIDs) that do not encode physical position",
      "scenarios": "S3, S4, S6",
      "verification": "Migrating an endpoint requires no change in any peer's state"
    },
    {
      "id": "IP2",
      "label": "Programmable indirection from LEID to physical port at every fabric attach point",
      "scenarios": "S1--S6",
      "verification": "Translation entries can be rewritten at runtime; lookup latency is bounded"
    },
    {
      "id": "IP3",
      "label": "Fabric-level discoverability: each attach point exposes a readable identity and capability descriptor",
      "scenarios": "S1, S2, S5",
      "verification": "Control plane enumerates all endpoints and links without prior knowledge beyond the root"
    },
    {
      "id": "IP4",
      "label": "Switched topology with programmable routing, not fixed point-to-point wiring or a single shared medium",
      "scenarios": "S1--S5",
      "verification": "Any admissible source--destination pair is reachable by table update alone"
    },
    {
      "id": "IP5",
      "label": "Path and lane redundancy",
      "scenarios": "S3, S5",
      "verification": "Single-link or lane failure leaves every admitted flow reachable"
    },
    {
      "id": "IP6",
      "label": "Protocol-agnostic packet transport with separated message classes (request, response, control, migration, telemetry)",
      "scenarios": "S1--S7",
      "verification": "Each class maps to its own virtual channel; no class can block another"
    },
    {
      "id": "IP7",
      "label": "Deadlock freedom for every admissible configuration and every transition between configurations",
      "scenarios": "S1--S6",
      "verification": "Channel dependency graph check passes before commit (Section sec:proto)"
    },
    {
      "id": "IP8",
      "label": "Ordering domains defined per microsystem rather than globally",
      "scenarios": "S4, S6",
      "verification": "Order preserved within a domain across migration; other domains unaffected"
    },
    {
      "id": "IP9",
      "label": "Scoped drain and quiesce primitives with completion detection",
      "scenarios": "S3, S4, S6",
      "verification": "Control plane can detect when no packets of a flow or version remain in flight"
    },
    {
      "id": "IP10",
      "label": "Versioned, atomic configuration with per-packet consistency",
      "scenarios": "S1--S7",
      "verification": "No packet is routed, translated, or filtered by a mixture of old and new configuration"
    },
    {
      "id": "IP11",
      "label": "Bounded, predictable reconfiguration time",
      "scenarios": "S3, S4",
      "verification": "Measured reconfiguration time stays within the bound of Eq. eq:trc"
    },
    {
      "id": "IP12",
      "label": "Reservable bandwidth and latency per flow",
      "scenarios": "S1, S2, S4",
      "verification": "Admitted flows meet their reservation while other flows are reconfigured"
    },
    {
      "id": "IP13",
      "label": "Protected control channel (out-of-band or reserved in-band) that survives data-plane congestion or failure",
      "scenarios": "All",
      "verification": "Configuration and telemetry remain deliverable under saturating data traffic and single data-link failure"
    },
    {
      "id": "IP14",
      "label": "Unforgeable source identity and endpoint firewalls",
      "scenarios": "S7, all",
      "verification": "A packet with a forged source or disallowed destination is dropped and reported"
    },
    {
      "id": "IP15",
      "label": "Authenticated configuration writes and scrub on reassignment",
      "scenarios": "S1, S6, S7",
      "verification": "Unsigned or stale-version configuration is rejected; buffers of a reassigned endpoint are cleared"
    },
    {
      "id": "IP16",
      "label": "Per-link and per-flow telemetry (errors, retries, latency, occupancy)",
      "scenarios": "S3, S5",
      "verification": "Counters readable at runtime without halting traffic"
    },
    {
      "id": "IP17",
      "label": "Error containment and repair (retry, lane repair, link isolation, poisoned-packet handling)",
      "scenarios": "S3, S5",
      "verification": "A failing link is isolated and flows rerouted without corrupting other flows"
    },
    {
      "id": "IP18",
      "label": "Trace and fault injection for V&V",
      "scenarios": "All",
      "verification": "Controlled faults can be injected on any link and their effect observed"
    },
    {
      "id": "IP19",
      "label": "Version and capability negotiation with protocol bridging",
      "scenarios": "S2, S5",
      "verification": "Chiplets of different interface revisions interoperate or are refused explicitly"
    },
    {
      "id": "IP20",
      "label": "Clock- and power-domain independence of attach points",
      "scenarios": "S5, S6",
      "verification": "An endpoint or region can be clock- or power-gated without stalling unrelated traffic"
    },
    {
      "id": "IP21",
      "label": "Always-reachable lifecycle proxy: identity, health, wake request, and isolation state remain accessible while the functional endpoint is gated",
      "scenarios": "S1, S5, S6",
      "verification": "A gated endpoint is discoverable and can be authenticated, awakened, tested, or refused without accessing its inactive functional registers"
    },
    {
      "id": "IP22",
      "label": "Typed electrical contract for every bindable physical port, checked before admission and after link-mode change",
      "scenarios": "S1--S6",
      "verification": "Incompatible signal type, voltage thresholds, drive/load current, data rate, or required standard-specific parameters prevent binding and are reported"
    }
  ],
  "constraints": [
    {
      "id": "DigitalCompatibility",
      "rules": [
        "providerVOHMin >= receiverVIHMin and providerVOLMax <= receiverVILMax and providerSourceCurrent >= receiverLoadCurrent and providerActualRate <= receiverMaxRate"
      ]
    },
    {
      "id": "AnalogRangeCompatibility",
      "rules": [
        "providerMin >= receiverAcceptedMin and providerMax <= receiverAcceptedMax and providerBandwidth >= receiverRequiredBandwidth"
      ]
    },
    {
      "id": "I2CBusCompatibility",
      "rules": [
        "deviceSinkCurrent >= busRequiredSinkCurrent and actualClockRate <= deviceMaxClockRate"
      ]
    }
  ]
}
