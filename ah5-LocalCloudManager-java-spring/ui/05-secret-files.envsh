#!/bin/sh
# Sourced by the nginx entrypoint before the templates are rendered (security finding J7): CONSOLE_PROXY_SECRET may come
# from a file (Compose secret, CONSOLE_PROXY_SECRET_FILE) instead of the container environment.
if [ -z "${CONSOLE_PROXY_SECRET:-}" ] && [ -n "${CONSOLE_PROXY_SECRET_FILE:-}" ]; then
  CONSOLE_PROXY_SECRET=$(cat "$CONSOLE_PROXY_SECRET_FILE") || { echo "$0: CONSOLE_PROXY_SECRET_FILE is not readable" >&2; exit 1; }
  export CONSOLE_PROXY_SECRET
fi
