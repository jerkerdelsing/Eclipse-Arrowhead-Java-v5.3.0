COMPOSE_PROJECT_NAME=ah5-localcloudmanager-testcloud
ARROWHEAD_NETWORK=arrowhead-local-cloud
LOCAL_CLOUD=TestCloud
ORGANIZATION=Company
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=8490
SERVICE_REGISTRY_ADDRESS=serviceregistry
SERVICE_REGISTRY_PORT=8443
AMQP_HOST=amqp-broker
AMQP_PORT=5671
SYSMONITOR_ENABLED=true
MANAGED_PROJECT=arrowhead-v52-test-cloud
MANAGED_SERVICES=sysmonitor,datamanager,timemanager,eventhandler
CONSOLE_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
LOCAL_CLOUD_CONFIGURATION_ENABLED=true
CHIPLET_FLOORPLANS_ENABLED=false
CHIPLET_MANAGER=false
LCM_API_WHITELIST=
SYSTEM_KEYSTORE_FILE=./security/LocalCloudManager.p12
TRUSTSTORE_FILE=./security/truststore.p12
STORE_PASSWORD_FILE=./security/store-password
IDENTITY_PASSWORD_FILE=./security/identity-password
CONSOLE_PASSWORD_HASH_FILE=./security/console-password-hash
CRL_DIRECTORY=./security/crl
CONTROL_SUBNET=10.252.220.0/24
