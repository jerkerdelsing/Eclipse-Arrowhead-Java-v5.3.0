# Copy to .env and adapt to an existing local cloud. No credentials are supplied.
COMPOSE_PROJECT_NAME=ah5-gatekeeper-testcloud
LOCAL_CLOUD=TestCloud
ORGANIZATION=Company
ARROWHEAD_NETWORK=arrowhead-local-cloud
SERVICE_REGISTRY_ADDRESS=serviceregistry
SERVICE_REGISTRY_PORT=8443
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=8449
# private network of Gatekeeper and its database; pick a free subnet per deployment on one Docker host
DB_SUBNET=10.252.212.0/24
# system identity (PKCS#12 with alias Gatekeeper.<LOCAL_CLOUD>.<ORGANIZATION>.arrowhead.eu, DNQ sy) and cloud trust
SYSTEM_KEYSTORE_FILE=./security/Gatekeeper.p12
TRUSTSTORE_FILE=./security/truststore.p12
STORE_PASSWORD_FILE=./security/store-password
IDENTITY_PASSWORD_FILE=./security/identity-password
CRL_DIRECTORY=./security/crl
# private MySQL (TLS required)
DB_PASSWORD_FILE=./security/db-password
DB_ROOT_PASSWORD_FILE=./security/db-root-password
DB_CA_FILE=./security/db-ca.crt
DB_CERT_FILE=./security/db.crt
DB_KEY_FILE=./security/db.key
# native sysMonitor publication (AMQPS, EXTERNAL authentication with the system certificate)
AMQP_HOST=amqp-broker
AMQP_PORT=5671
SYSMONITOR_ENABLED=true
# federation: ah-gt-1 (default) or legacy-mtls, never a silent downgrade
FEDERATION_PROFILE=ah-gt-1
FEDERATION_PEER_ORGANIZATIONS=
# relay link with its own organisation-signed identity
RELAY_HOST=arrowhead-relay
RELAY_PORT=8883
RELAY_CHAIN_FILE=./security/gatekeeper-relay-chain.crt
RELAY_KEY_FILE=./security/gatekeeper-relay.key
ORGANIZATION_CA_FILE=./security/org-ca.crt
# CRL of the organisation CA (revocation of the relay's server certificate, fail closed; renew before its nextUpdate)
ORGANIZATION_CRL_FILE=./security/org-ca.crl
