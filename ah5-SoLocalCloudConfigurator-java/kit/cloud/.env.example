# make init copies this to .env and adds random per-cloud secrets (scripts/rotate-secrets.sh generate).
COMPOSE_PROJECT_NAME=arrowhead-v53-test-cloud
AH_VERSION=5.2.2
# Upstream 5.2.2 images are amd64-only. Docker Desktop emulates this on ARM Macs.
DOCKER_PLATFORM=linux/amd64
BIND_ADDRESS=127.0.0.1


# Host API ports (container-to-container ports remain the Arrowhead defaults).
SERVICEREGISTRY_PORT=8443
DYNAMIC_ORCHESTRATION_PORT=8441
SIMPLE_ORCHESTRATION_PORT=8442
CONSUMER_AUTHORIZATION_PORT=8445
AUTHENTICATION_PORT=8444
BLACKLIST_PORT=8464
TRANSLATION_MANAGER_PORT=8465
DEVICE_QOS_EVALUATOR_PORT=8472
ONBOARDING_PORT=8435
CLOUD_MONITOR_PORT=8490
DATAMANAGER_PORT=8461
GRAPHDBMANAGER_PORT=8467
RANDOM_DATA_PRODUCER_PORT=8500
GATEKEEPER_PORT=8449
GATETUNNEL_PORT=8453
SYSMONITOR_PORT=8475
MQTT_TLS_PORT=8883
AMQP_TLS_PORT=5671
EVENTHANDLER_PORT=8455
TIMEMANAGER_PORT=8463
CONFIGURATION_PORT=8459
CHOREOGRAPHER_PORT=8457
