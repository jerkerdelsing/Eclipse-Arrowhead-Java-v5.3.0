%% Local-cloud AMQP broker TLS (all ssl_options live here: advanced.config replaces, not merges, the ssl_options of
%% rabbitmq.conf). Mutual TLS with the cloud CA, TLS 1.3/1.2, and revocation checking (security finding H3): the client
%% certificate is checked against the cloud CA's CRL, which entrypoint.sh links into the hash directory under the
%% OpenSSL subject hash of the CA (in /tmp/rabbitmq-crl, J3). The directory is read on every connection, so a new CRL applies without a reload.
%% A missing or expired CRL refuses every client (fail closed).
[{rabbit, [{ssl_options, [{cacertfile, "/certs/ca.crt"},
                          {certfile, "/certs/amqp-broker.crt"},
                          {keyfile, "/certs/amqp-broker.key"},
                          {verify, verify_peer},
                          {fail_if_no_peer_cert, true},
                          {versions, ['tlsv1.3', 'tlsv1.2']},
                          {crl_check, peer},
                          {crl_cache, {ssl_crl_hash_dir, {internal, [{dir, "/tmp/rabbitmq-crl"}]}}}]}]}].
